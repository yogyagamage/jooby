    @Test
    void testRenderTriggersSendClose() throws Exception {
        // Create mocks for constructor dependencies
        UtowContext ctx = Mockito.mock(UtowContext.class);
        WebSocketChannel channel = Mockito.mock(WebSocketChannel.class);
        
        // Mock the router and its logger to avoid NPE
        Router router = Mockito.mock(Router.class);
        Logger logger = Mockito.mock(Logger.class);
        Mockito.when(router.getLog()).thenReturn(logger);
        
        // Mock config to avoid NPE when accessing websocket settings
        Config config = Mockito.mock(Config.class);
        Mockito.when(router.getConfig()).thenReturn(config);
        Mockito.when(config.hasPath(Mockito.anyString())).thenReturn(false);
        
        Mockito.when(ctx.getRouter()).thenReturn(router);
        Mockito.when(ctx.isInIoThread()).thenReturn(false);
        
        // Mock route and pattern
        Route route = Mockito.mock(Route.class);
        Mockito.when(ctx.getRoute()).thenReturn(route);
        Mockito.when(route.getPattern()).thenReturn("test-key");
        
        // Create instance using the provided constructor
        UtowWebSocket websocket = new UtowWebSocket(ctx, channel);
        
        // Set the websocket as open so handleClose will call sendClose
        // We need to access the private 'open' field - using reflection
        java.lang.reflect.Field openField = UtowWebSocket.class.getDeclaredField("open");
        openField.setAccessible(true);
        AtomicBoolean openValue = (AtomicBoolean) openField.get(websocket);
        openValue.set(true);
        
        // Create a throwable that will trigger the onError -> handleClose path
        // Server.connectionLost(x) must return true to enter the if block
        Throwable throwable = new IOException("Connection lost");
        
        // Call the entry point with broadcast=false to trigger the try-catch block
        websocket.render("test-value", false);
    }
}

