@Nonnull
@Override
public WebSocket render(@Nonnull
Object value, boolean broadcast) {
    if (broadcast) {
        for (WebSocket ws : all.getOrDefault(key, Collections.emptyList())) {
            ws.render(value, false);
        }
    } else {
        try {
            Context.websocket(ctx, this).render(value);
        } catch (Throwable x) // PATH: Test should invoke the next UtowWebSocket.onError(...) [step in execution path]
        {
            onError(channel, x);
        }
    }
    return this;
}

@Override
protected void onError(WebSocketChannel channel, Throwable x) {
    // should close?
    if (Server.connectionLost(x) || SneakyThrows.isFatal(x)) {
        if (isOpen()) // PATH: Test should invoke the next UtowWebSocket.handleClose(...) [step in execution path]
        {
            handleClose(WebSocketCloseStatus.SERVER_ERROR);
        }
    }
    if (onErrorCallback == null) {
        if (Server.connectionLost(x)) {
            ctx.getRouter().getLog().debug("Websocket connection lost: {}", ctx.getRequestPath(), x);
        } else {
            ctx.getRouter().getLog().error("Websocket resulted in exception: {}", ctx.getRequestPath(), x);
        }
    } else {
        onErrorCallback.onError(this, x);
    }
    if (SneakyThrows.isFatal(x)) {
        throw SneakyThrows.propagate(x);
    }
}

private void handleClose(WebSocketCloseStatus status) {
    OnClose callback = onCloseCallback.getAndSet(null);
    if (isOpen()) // PATH: Test should invoke the next WebSockets.sendClose(...) [step in execution path]
    {
        open.set(false);
        // close socket:
        sendClose(status.getCode(), status.getReason(), channel, new WebSocketCallback<UtowWebSocket>() {
            @Override
            public void onError(final WebSocketChannel channel, final UtowWebSocket ws, final Throwable throwable) {
                IoUtils.safeClose(channel);
                ws.onError(channel, throwable);
            }

            @Override
            public void complete(final WebSocketChannel channel, final UtowWebSocket ws) {
                IoUtils.safeClose(channel);
            }
        }, this);
    }
    try {
        // fire callback:
        if (callback != null) {
            callback.onClose(this, status);
        }
    } catch (Throwable x) {
        // fire error:
        onError(channel, x);
    } finally {
        // clear from active sessions:
        removeSession(this);
    }
}
