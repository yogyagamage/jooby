    @Test
    public void start_shouldInvokeSetBufferSize() throws Exception {
        // Create instance of class under test
        Utow utow = new Utow();
        
        // Create mock Jooby application
        Jooby mockApplication = Mockito.mock(Jooby.class);
        Environment mockEnvironment = Mockito.mock(Environment.class);
        Router mockRouter = Mockito.mock(Router.class);
        ClassLoader mockClassLoader = Mockito.mock(ClassLoader.class);
        
        // Configure mock behavior
        when(mockApplication.getEnvironment()).thenReturn(mockEnvironment);
        when(mockEnvironment.getClassLoader()).thenReturn(mockClassLoader);
        when(mockApplication.getRouter()).thenReturn(mockRouter);
        
        // Configure ServerOptions to ensure setBufferSize is called
        ServerOptions options = new ServerOptions()
            .setBufferSize(8192) // Ensure buffer size is set
            .setIoThreads(ServerOptions.IO_THREADS)
            .setWorkerThreads(ServerOptions.WORKER_THREADS)
            .setPort(8080)
            .setHost("localhost")
            .setDefaultHeaders(false)
            .setHttpsOnly(false);
        
