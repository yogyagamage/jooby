@Override
public ServerSentEmitter keepAlive(long timeInMillis) {
    if (checkOpen()) {
        XnioIoThread executor = utow.exchange.getIoThread();
        executor.executeAfter(new KeepAlive(this, timeInMillis), timeInMillis, TimeUnit.MILLISECONDS);
    }
    return this;
}
