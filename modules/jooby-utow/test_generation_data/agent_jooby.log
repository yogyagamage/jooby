    /**
     * default headers:
     */
    HeaderMap responseHeaders = exchange.getResponseHeaders();
    responseHeaders.put(Headers.CONTENT_TYPE, "text/plain");
    if (defaultHeaders) {
        responseHeaders.put(Headers.SERVER, "U");
    }
    if (context.isHttpGet()) {
        router.match(context).execute(context);
