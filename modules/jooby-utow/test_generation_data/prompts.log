setters:
```java
@Nonnull
@Override
public void close() {
    if (open.compareAndSet(true, false)) {
        if (closeTask != null) {
            try {
                closeTask.run();
            } finally {
                utow.exchange.endExchange();
            }
        }
    }
}

@Override
public void onClose(SneakyThrows.Runnable task) {
    this.closeTask = task;
}

@Override
public void onException(HttpServerExchange exchange, Sender sender, IOException exception) {
    if (Server.connectionLost(exception)) {
        close();
    } else {
        log.error("server-sent-event resulted in exception: id {} {}", id, utow.getRequestPath(), exception);
        if (SneakyThrows.isFatal(exception)) {
            throw SneakyThrows.propagate(exception);
        }
    }
