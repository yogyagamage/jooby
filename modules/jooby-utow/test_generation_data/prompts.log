private void ifSaveSession() {
    if (attributes != null) {
        Session session = ((Session) (attributes.get(Session.NAME)));
        if ((session != null) && (session.isNew() || session.isModify())) {
            SessionStore store = router.getSessionStore();
            store.saveSession(this, session);
        }
    }
}

