                IoUtils.safeClose(channel);
            }
        }, this);
    }
    try {
        // fire callback:
        if (callback != null) {
            callback.onClose(this, status);
        }
    } catch (Throwable x) {
        // fire error:
        onError(channel, x);
    } finally {
        // clear from active sessions:
        removeSession(this);
    }
}

