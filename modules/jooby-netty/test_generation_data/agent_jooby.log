@Nonnull
@Override
public void close() {
    if (open.compareAndSet(true, false)) {
        try {
            if (closeTask != null) {
                log.debug("running close task on sse {}", id);
                closeTask.run();
            }
        } finally {
            log.debug("closing sse {}", id);
            netty.ctx.close();
        }
    }
}

@Override
public void onClose(SneakyThrows.Runnable task) {
