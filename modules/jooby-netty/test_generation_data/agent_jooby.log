@Override
public Context send(StatusCode statusCode) {
    try {
        setResponseCode(statusCode);
        responseStarted = true;
        if (!setHeaders.contains(CONTENT_LENGTH)) {
            setHeaders.set(CONTENT_LENGTH, "0");
        }
        DefaultFullHttpResponse rsp = new DefaultFullHttpResponse(HTTP_1_1, status, Unpooled.EMPTY_BUFFER, setHeaders, NO_TRAILING);
        ctx.writeAndFlush(rsp, promise(this));
        return this;
    } finally {
        requestComplete();
    }
}
