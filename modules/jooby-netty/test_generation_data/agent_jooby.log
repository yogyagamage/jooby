            @Override
            public int read(ByteBuffer dst) {
                return seekableChannel.read(dst);
            }

            @Override
            public boolean isOpen() {
                return seekableChannel.isOpen();
            }

            @Override
            public void close() {
                seekableChannel.close();
            }
        };

        // Call the entry point method
        nettyContext.send(channel);
    }
