import io.jooby.SneakyThrows;
import io.netty.util.concurrent.Future;
import io.netty.util.concurrent.GenericFutureListener;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import static org.mockito.Mockito.when;

public class NettyServerSentEmitteroperationComplete_FutureisSuccessFikaTest {

    @Test
    public void testOperationCompleteInvokesFutureIsSuccess() throws Exception {
        // Create mock NettyContext required for constructor
        NettyContext mockNettyContext = Mockito.mock(NettyContext.class);
        
        // Create instance of class under test using provided constructor
        NettyServerSentEmitter emitter = new NettyServerSentEmitter(mockNettyContext);
        
        // Create mock Future that will be passed to operationComplete
        Future mockFuture = Mockito.mock(Future.class);
        
        // Configure the mock to return false for isSuccess() to follow the desired path
        when(mockFuture.isSuccess()).thenReturn(false);
        
        // Create a non-fatal throwable for the cause
        Throwable mockCause = Mockito.mock(Throwable.class);
        when(mockFuture.cause()).thenReturn(mockCause);
        
        // Configure Server.connectionLost to return false to avoid close() call
        // We'll use Mockito to mock the static method
        try (var mockedServer = Mockito.mockStatic(Server.class)) {
            mockedServer.when(() -> Server.connectionLost(mockCause)).thenReturn(false);
            
            // Configure SneakyThrows.isFatal to return false to avoid exception propagation
            try (var mockedSneakyThrows = Mockito.mockStatic(SneakyThrows.class)) {
                mockedSneakyThrows.when(() -> SneakyThrows.isFatal(mockCause)).thenReturn(false);
                
                // Invoke the entry point method - this should trigger future.isSuccess()
                emitter.operationComplete(mockFuture);
            }
        }
    }
}

