        // Ensure isKeepAlive returns false to enter the branch where channel().close() is called
        when(mockFuture.cause()).thenReturn(null);

        // Invoke the entry point method
        nettyContext.operationComplete(mockFuture);
        
        // No assertions - test passes if no exceptions are thrown
    }
}

