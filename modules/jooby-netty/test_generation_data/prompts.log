                if ((contentLength > 0) || HttpUtil.isTransferEncodingChunked(req)) {
                    decoder = newDecoder(req, factory);
                } else {
                    // no body, move on
                    router.match(context).execute(context);
                }
            }
        } else if ((decoder != null) && (msg instanceof HttpContent)) {
