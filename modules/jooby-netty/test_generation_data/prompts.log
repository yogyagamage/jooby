@Override
public ServerSentEmitter keepAlive(long timeInMillis) {
    if (checkOpen()) {
        EventLoop executor = netty.ctx.channel().eventLoop().next();
        executor.schedule(new KeepAlive(this, timeInMillis), timeInMillis, TimeUnit.MILLISECONDS);
    }
    return this;
}
