public Map<String, String> cookieMap() {
    if (this.cookies == null) {
        this.cookies = Collections.emptyMap();
        String cookieString = req.headers().get(HttpHeaderNames.COOKIE);
        if (cookieString != null) {
            // PATH: Test should invoke the next ServerCookieDecoder.decode(...) [step in execution path]
            Set<Cookie> cookies = ServerCookieDecoder.STRICT.decode(cookieString);
            if (cookies.size() > 0) {
                this.cookies = new LinkedHashMap<>(cookies.size());
                for (Cookie it : cookies) {
                    this.cookies.put(it.name(), it.value());
                }
            }
        }
    }
    return this.cookies;
}
