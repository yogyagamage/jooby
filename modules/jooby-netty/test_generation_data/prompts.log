@Override
public void exceptionCaught(ChannelHandlerContext ctx, Throwable cause) {
    try {
        Logger log = router.getLog();
        if (Server.connectionLost(cause)) {
            if (log.isDebugEnabled()) {
                if (context == null) {
                    log.debug("execution resulted in connection lost", cause);
                } else {
