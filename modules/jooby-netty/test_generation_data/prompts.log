@Override
public Path path() {
    try {
        if (path == null) {
            if (upload.isInMemory()) {
                path = basedir.resolve((DiskFileUpload.prefix + System.nanoTime()) + DiskFileUpload.postfix);
                upload.renameTo(path.toFile());
                upload.release();
            } else {
                path = upload.getFile().toPath();
            }
        }
        return path;
    } catch (IOException x) {
        throw SneakyThrows.propagate(x);
    }
}
```
