private WebSocket send(ByteBuf buffer, boolean broadcast) {
    if (broadcast) {
        for (NettyWebSocket ws : all.getOrDefault(key, Collections.emptyList())) {
            ws.send(buffer, false);
        }
    } else if (isOpen()) {
