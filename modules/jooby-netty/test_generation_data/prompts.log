}

private void removeSession(NettyWebSocket ws) {
    List<NettyWebSocket> sockets = all.get(ws.key);
    if (sockets != null) {
        sockets.remove(ws);
    }
}

private void waitForConnect() {
    try {
        ready.await();
    } catch (InterruptedException x) {
        Thread.currentThread().interrupt();
    }
}
