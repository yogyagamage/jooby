        needsFlush = false;
        ctx.flush();
    }
}

private void ifSaveSession() {
    Session session = getSession();
    if (session != null) {
        SessionStore store = router.getSessionStore();
        store.saveSession(this, session);
    }
}

private void prepareChunked() {
    // remove flusher, doesn't play well with streaming/chunked responses
    ChannelPipeline pipeline = ctx.pipeline();
    if (pipeline.get("chunker") == null) {
        String base = Stream.of("compressor", "codec", "http2").filter(name -> pipeline.get(name) != null).findFirst().orElseThrow(() -> new IllegalStateException("No available handler for chunk writer"));
