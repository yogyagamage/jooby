    } catch (HttpPostRequestDecoder.ErrorDataDecoderException x) {
        resetDecoderState(true);
        context.sendError(x, StatusCode.BAD_REQUEST);
    }
}

private void resetDecoderState(boolean destroy) {
    chunkSize = 0;
    contentLength = -1;
    if (destroy && (decoder != null)) {
        decoder.destroy();
