@Override
public void channelRead(ChannelHandlerContext ctx, Object msg) {
    try {
        if (msg instanceof HttpRequest) {
            HttpRequest req = ((HttpRequest) (msg));
            context = new NettyContext(ctx, req, router, pathOnly(req.uri()), bufferSize);
