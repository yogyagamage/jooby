            }
        }
        files = null;
    }
    if (decoder != null) {
        try {
            decoder.destroy();
        } catch (Exception x) {
            router.getLog().debug("body decoder destroy resulted in exception", x);
        }
        decoder = null;
    }
    release(req);
}

