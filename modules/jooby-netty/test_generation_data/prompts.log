@Nonnull
@Override
public List<Certificate> getClientCertificates() {
    SslHandler sslHandler = ((SslHandler) (ctx.channel().pipeline().get("ssl")));
    if (sslHandler != null) {
        try {
            return Arrays.asList(// PATH: Test should invoke the next SslHandler.engine(...) [step in execution path]
            sslHandler.engine().getSession().getPeerCertificates());
        } catch (SSLPeerUnverifiedException x) {
            throw SneakyThrows.propagate(x);
        }
    }
    return new ArrayList<Certificate>();
}
