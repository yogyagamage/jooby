@Override
public ServerSentEmitter keepAlive(long timeInMillis) {
    // PATH: Test should invoke the next NettyServerSentEmitter.checkOpen(...) [step in execution path]
    if (checkOpen()) {
        EventLoop executor = netty.ctx.channel().eventLoop().next();
        executor.schedule(new KeepAlive(this, timeInMillis), timeInMillis, TimeUnit.MILLISECONDS);
    }
    return this;
}

private boolean checkOpen() {
    if (isOpen()) {
        // client might be close the channel:
        if (// PATH: Test should invoke the next ChannelHandlerContext.channel(...) [step in execution path]
        netty.ctx.channel().isOpen()) {
            return true;
        } else {
            close();
            return false;
        }
    }
