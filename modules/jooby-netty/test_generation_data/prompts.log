@Nonnull
@Override
public ServerSentEmitter send(ServerSentMessage data) {
    if (checkOpen()) {
        netty.ctx.writeAndFlush(Unpooled.wrappedBuffer(data.toByteArray(netty))).addListener(this);
    } else {
        log.warn("server-sent-event closed: {}", id);
    }
    return this;
}
