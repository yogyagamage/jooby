                WebSocketMessage message = WebSocketMessage.create(getContext(), array(content));
                fireCallback(webSocketTask(() -> messageCallback.onMessage(this, message), false));
            } else {
                buffer = Unpooled.copiedBuffer(frame.content());
            }
        }
    } finally {
        frame.release();
    }
}

