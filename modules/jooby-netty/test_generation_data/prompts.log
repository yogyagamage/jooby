private Context send(@Nonnull
ByteBuf data) {
    try {
        responseStarted = true;
        setHeaders.set(CONTENT_LENGTH, Long.toString(data.readableBytes()));
        DefaultFullHttpResponse response = new DefaultFullHttpResponse(HTTP_1_1, status, data, setHeaders, NO_TRAILING);
        if (ctx.channel().eventLoop().inEventLoop()) {
