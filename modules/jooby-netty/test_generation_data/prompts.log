```java
public NettyContext(ChannelHandlerContext ctx, HttpRequest req, Router router, String path, int bufferSize) {
    this.path = path;
    this.ctx = ctx;
    this.req = req;
    this.router = router;
    this.bufferSize = bufferSize;
    this.method = req.method().name().toUpperCase();
    // Safe streamId for HTTP/2
    this.streamId = header(STREAM_ID).valueOrNull();
    ifStreamId(this.streamId);
}
```
