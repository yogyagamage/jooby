{"version":"1.153.0","results":[{"check_id":"ssc-260aea16-d390-49d9-9bba-3606330930d3","path":"pom.xml","start":{"line":1,"col":1,"offset":0},"end":{"line":1,"col":1,"offset":0},"extra":{"metavars":{},"message":"Affected versions of io.netty:netty-codec-http2 are vulnerable to Uncontrolled Resource Consumption. The vulnerability arises when a client issues frequent `RST frames`, potentially leading to server overload and facilitating a DDoS attack by imposing a significant load on the remote system.","metadata":{"confidence":"HIGH","category":"security","cve":"","cwe":["CWE-400: Uncontrolled Resource Consumption"],"ghsa":"GHSA-xpw8-rcwv-8f8p","owasp":["A06:2021 - Vulnerable and Outdated Components"],"publish-date":"2023-10-10T22:22:54Z","references":["https://github.com/advisories/GHSA-xpw8-rcwv-8f8p","https://nvd.nist.gov/vuln/detail/CVE-2023-44487"],"sca-fix-versions":[{"io.netty:netty-codec-http2":"4.1.100.Final"}],"sca-kind":"upgrade-only","sca-schema":20230302,"sca-severity":"HIGH","sca-vuln-database-identifier":"GHSA-xpw8-rcwv-8f8p","technology":["java","kotlin","scala"],"license":"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license","vulnerability_class":["Denial-of-Service (DoS)"],"semgrep.dev":{"rule":{"r_id":94232,"rv_id":952693,"rule_id":"lBU49bg","version_id":"2KTYLb4","url":"https://semgrep.dev/orgs/-/supply-chain/advisories?q=ssc-260aea16-d390-49d9-9bba-3606330930d3","origin":"custom","rule_name":"ssc-260aea16-d390-49d9-9bba-3606330930d3"},"src":"unchanged"},"source":"https://semgrep.dev/orgs/-/supply-chain/advisories?q=ssc-260aea16-d390-49d9-9bba-3606330930d3","semgrep.url":"https://semgrep.dev/orgs/-/supply-chain/advisories?q=ssc-260aea16-d390-49d9-9bba-3606330930d3","dev.semgrep.actions":[]},"severity":"ERROR","fingerprint":"33f820a80e7711f4bdb4843db3e900a50e2d6dce37867ac689d48048c2d56f790e1062585bf2646660bf494fbd47ba2052baec9f63c17d52ed72f1467df4a00d_0","lines":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>","is_ignored":false,"sca_info":{"reachability_rule":false,"sca_finding_schema":20220913,"dependency_match":{"dependency_pattern":{"ecosystem":"maven","package":"io.netty:netty-codec-http2","semver_range":"<4.1.100.Final"},"found_dependency":{"package":"io.netty:netty-codec-http2","version":"4.1.80.Final","ecosystem":"maven","allowed_hashes":{},"transitivity":"direct","manifest_path":"pom.xml","lockfile_path":"pom.xml","line_number":1,"children":[{"package":"io.netty:netty-buffer","version":"4.1.80.Final"},{"package":"io.netty:netty-codec","version":"4.1.80.Final"},{"package":"io.netty:netty-common","version":"4.1.80.Final"},{"package":"io.netty:netty-transport","version":"4.1.80.Final"}]},"lockfile":"pom.xml"},"reachable":false},"engine_kind":"OSS"}},{"check_id":"ssc-27f34c41-f34b-4495-9e39-28ce8a153dca","path":"pom.xml","start":{"line":1,"col":1,"offset":0},"end":{"line":1,"col":1,"offset":0},"extra":{"metavars":{},"message":"Affected versions of io.grpc:grpc-netty-shaded and io.netty:netty-codec-http2 are vulnerable to Allocation of Resources Without Limits or Throttling. Netty's HTTP/2 implementation fails to correctly track active streams when sending RST_STREAM in response to certain malformed control frames. An attacker can send, for example, WINDOW_UPDATE frames with a zero or overflow increment, HEADERS/DATA on a half-closed stream, or PRIORITY frames with invalid length to trigger RST_STREAMs; each reset decrements Netty's concurrent-stream counter even though the request is still processed. By repeating this on a single connection, the attacker can open an unbounded number of streams, exhausting CPU and memory and causing a denial of service. This is a protocol level attack.","metadata":{"confidence":"HIGH","category":"security","cve":"CVE-2025-55163","cwe":["CWE-770: Allocation of Resources Without Limits or Throttling"],"ghsa":"GHSA-prj3-ccx8-p6x4","owasp":["A06:2021 - Vulnerable and Outdated Components"],"publish-date":"2025-08-13T19:06:56Z","references":["https://github.com/advisories/GHSA-prj3-ccx8-p6x4","https://nvd.nist.gov/vuln/detail/CVE-2025-55163"],"sca-fix-versions":[{"io.grpc:grpc-netty-shaded":"1.75.0"},{"io.netty:netty-codec-http2":"4.2.4.Final"},{"io.netty:netty-codec-http2":"4.1.124.Final"}],"sca-kind":"upgrade-only","sca-schema":20230302,"sca-severity":"HIGH","sca-vuln-database-identifier":"CVE-2025-55163","technology":["java","kotlin","scala"],"license":"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license","vulnerability_class":["Other"],"semgrep.dev":{"rule":{"r_id":208926,"rv_id":1153640,"rule_id":"6JUZzL2","version_id":"X0T2Gb8","url":"https://semgrep.dev/orgs/-/supply-chain/advisories?q=ssc-27f34c41-f34b-4495-9e39-28ce8a153dca","origin":"custom","rule_name":"ssc-27f34c41-f34b-4495-9e39-28ce8a153dca"},"src":"unchanged"},"source":"https://semgrep.dev/orgs/-/supply-chain/advisories?q=ssc-27f34c41-f34b-4495-9e39-28ce8a153dca","semgrep.url":"https://semgrep.dev/orgs/-/supply-chain/advisories?q=ssc-27f34c41-f34b-4495-9e39-28ce8a153dca","dev.semgrep.actions":[]},"severity":"ERROR","fingerprint":"c22786d10dbd97fcd438a4ceac50553973f01a8fbd5953ffaf00e34ca3cbc0d65714c116c01fdc3d782c50722858bfb36de5088236370a9c2876314f6222bdc6_0","lines":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>","is_ignored":false,"sca_info":{"reachability_rule":false,"sca_finding_schema":20220913,"dependency_match":{"dependency_pattern":{"ecosystem":"maven","package":"io.netty:netty-codec-http2","semver_range":"<=4.1.123.Final"},"found_dependency":{"package":"io.netty:netty-codec-http2","version":"4.1.80.Final","ecosystem":"maven","allowed_hashes":{},"transitivity":"direct","manifest_path":"pom.xml","lockfile_path":"pom.xml","line_number":1,"children":[{"package":"io.netty:netty-buffer","version":"4.1.80.Final"},{"package":"io.netty:netty-codec","version":"4.1.80.Final"},{"package":"io.netty:netty-common","version":"4.1.80.Final"},{"package":"io.netty:netty-transport","version":"4.1.80.Final"}]},"lockfile":"pom.xml"},"reachable":false},"engine_kind":"OSS"}},{"check_id":"ssc-80b5ff99-02f7-5855-980f-d062664ea991","path":"pom.xml","start":{"line":1,"col":1,"offset":0},"end":{"line":1,"col":1,"offset":0},"extra":{"metavars":{},"message":"Affected versions of io.netty:netty-codec-http are vulnerable to Inconsistent Interpretation of HTTP Requests ('HTTP Request/Response Smuggling'). Netty's HTTP chunked‐encoding parser treats a lone LF in a chunk extension as the end of the size line (instead of requiring CRLF per RFC 9112). If a front‐end proxy instead treats that LF as part of the extension, an attacker can craft a \"funky chunks\" payload that the proxy sees as one request but Netty splits into two, enabling standard HTTP request‐smuggling attacks—bypassing access controls and corrupting responses to other clients.","metadata":{"confidence":"HIGH","category":"security","cve":"CVE-2025-58056","cwe":["CWE-444: Inconsistent Interpretation of HTTP Requests ('HTTP Request/Response Smuggling')"],"ghsa":"GHSA-fghv-69vj-qj49","owasp":["A04:2021 - Insecure Design","A06:2021 - Vulnerable and Outdated Components","A06:2025 - Insecure Design"],"publish-date":"2025-09-04T17:35:20Z","references":["https://github.com/advisories/GHSA-fghv-69vj-qj49","https://nvd.nist.gov/vuln/detail/CVE-2025-58056"],"sca-fix-versions":[{"io.netty:netty-codec-http":"4.2.5.Final"},{"io.netty:netty-codec-http":"4.1.125.Final"}],"sca-kind":"reachable","sca-schema":20230302,"sca-severity":"LOW","sca-vuln-database-identifier":"CVE-2025-58056","technology":["java","kotlin","scala"],"license":"Semgrep Rules License v1.0. For more details, visit semgrep.dev/legal/rules-license","vulnerability_class":["Improper Validation"],"semgrep.dev":{"rule":{"r_id":210483,"rv_id":1240350,"rule_id":"lBUlNEE","version_id":"kbTzvpl","url":"https://semgrep.dev/orgs/-/supply-chain/advisories?q=ssc-80b5ff99-02f7-5855-980f-d062664ea991","origin":"custom","rule_name":"ssc-80b5ff99-02f7-5855-980f-d062664ea991"},"src":"unchanged"},"source":"h