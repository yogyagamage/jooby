package io.jooby.jetty;

import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import io.jooby.Environment;
import io.jooby.Router;
import io.jooby.WebSocket;
import com.typesafe.config.Config;
import com.typesafe.config.ConfigFactory;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import javax.net.ssl.SSLContext;
import java.security.NoSuchAlgorithmException;
import java.util.Collections;

public class Jettystart_ConfiggetBytesFikaTest {

    @Test
    public void testStart() throws Exception {
        Jetty jetty = new Jetty();
        
        ServerOptions options = new ServerOptions();
        options.setPort(0);
        options.setSecurePort(0);
        options.setWorkerThreads(1);
        options.setBufferSize(8192);
        options.setMaxRequestSize(1000000L);
        options.setHttp2(false);
        options.setHttpsOnly(false);
        options.setSSLEnabled(false);
        options.setDefaultHeaders(false);
        
        SslOptions sslOptions = new SslOptions();
        sslOptions.setProtocol(Collections.singletonList("TLSv1.2"));
        options.setSsl(sslOptions);
        
        jetty.setOptions(options);
        
        Config config = ConfigFactory.parseString("websocket.maxSize = 1024\nwebsocket.idleTimeout = 1s");
        
        Environment environment = Mockito.mock(Environment.class);
        Mockito.when(environment.getClassLoader()).thenReturn(Thread.currentThread().getContextClassLoader());
        
        Router router = Mockito.mock(Router.class);
        
        Jooby application = Mockito.mock(Jooby.class);
        Mockito.when(application.getConfig()).thenReturn(config);
        Mockito.when(application.getEnvironment()).thenReturn(environment);
        Mockito.when(application.getRouter()).thenReturn(router);
        
        SSLContext sslContext;
        try {
            sslContext = SSLContext.getDefault();
        } catch (NoSuchAlgorithmException e) {
            sslContext = SSLContext.getInstance("TLS");
        }
        Mockito.when(options.getSSLContext(Mockito.any(ClassLoader.class))).thenReturn(sslContext);
        
        jetty.start(application);
    }
}

