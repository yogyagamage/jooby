        options.setSsl(sslOptions);
        
        // Set options on Jetty instance
        jetty.setOptions(options);
        
        // Create a minimal Jooby application
        Jooby app = new Jooby();
        
        // Start Jetty - this should trigger the setWantClientAuth(true) call
        jetty.start(app);
        
        // Clean up
        jetty.stop();
    }
}

