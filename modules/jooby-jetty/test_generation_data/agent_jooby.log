package io.jooby.jetty;

import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import org.eclipse.jetty.util.ssl.SslContextFactory;
import org.junit.jupiter.api.Test;

import javax.net.ssl.SSLContext;
import java.lang.reflect.Method;

public class Jettystart_ServersetNeedClientAuthFikaTest {

    @Test
    public void testStart() throws Exception {
        Jetty jetty = new Jetty();
        
        ServerOptions options = new ServerOptions();
        options.setSSLEnabled(true);
        options.setSecurePort(8443);
        
        SslOptions sslOptions = new SslOptions();
        sslOptions.setClientAuth(SslOptions.ClientAuth.REQUIRED);
        
        // Use reflection to set ssl options since setSsl method might not be public
        Method setSslMethod = ServerOptions.class.getDeclaredMethod("setSsl", SslOptions.class);
        setSslMethod.setAccessible(true);
        setSslMethod.invoke(options, sslOptions);
        
        // Use reflection to set options field
        java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
        optionsField.setAccessible(true);
        optionsField.set(jetty, options);
        
        // Create a minimal Jooby application
        Jooby app = new Jooby();
        
        // Start the server
        jetty.start(app);
    }
}

