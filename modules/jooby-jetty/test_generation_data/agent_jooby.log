package io.jooby.jetty;

import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import javax.net.ssl.SSLContext;
import java.lang.reflect.Method;

public class Jettystart_SslConnectionFactorymethodFikaTest {

    @Test
    public void testStartTriggersSslConnectionFactoryInit() throws Exception {
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Create a mock Jooby application
        Jooby application = Mockito.mock(Jooby.class);
        io.jooby.Environment environment = Mockito.mock(io.jooby.Environment.class);
        Mockito.when(application.getEnvironment()).thenReturn(environment);
        Mockito.when(environment.getClassLoader()).thenReturn(Thread.currentThread().getContextClassLoader());
        
        // Create mock config
        com.typesafe.config.Config config = Mockito.mock(com.typesafe.config.Config.class);
        Mockito.when(application.getConfig()).thenReturn(config);
        Mockito.when(config.hasPath("websocket.maxSize")).thenReturn(false);
        Mockito.when(config.hasPath("websocket.idleTimeout")).thenReturn(false);
        
        // Configure SSL to ensure SslConnectionFactory is created
        ServerOptions options = new ServerOptions();
        options.setSSLEnabled(true);
        options.setPort(8080);
        options.setSecurePort(8443);
        options.setHost("localhost");
        
        // Create SSL options
        SslOptions sslOptions = new SslOptions();
        sslOptions.setProtocol(java.util.Arrays.asList("TLSv1.2", "TLSv1.3"));
        
        // Use reflection to set the private options field
        try {
            Method setOptionsMethod = Jetty.class.getDeclaredMethod("setOptions", ServerOptions.class);
            setOptionsMethod.setAccessible(true);
            setOptionsMethod.invoke(jetty, options);
        } catch (NoSuchMethodException e) {
            // Fallback to field access if setter doesn't exist
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        }
        
        // Set SSL context
        SSLContext sslContext = SSLContext.getDefault();
        options.setSSLContext(sslContext);
        
        // Set SSL options
        options.setSsl(sslOptions);
        
        // Start the server - this should trigger SslConnectionFactory constructor
        jetty.start(application);
        
        // Clean up to avoid port binding issues in subsequent tests
        try {
            jetty.stop();
        } catch (Exception e) {
            // Ignore cleanup errors
        }
    }
}

