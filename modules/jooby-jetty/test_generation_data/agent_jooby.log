    @Test
    public void testStartInvokesConfigHasPath() throws Exception {
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Create mock Jooby application
        Jooby mockApplication = Mockito.mock(Jooby.class);
        
        // Create mock Environment
        Environment mockEnvironment = Mockito.mock(Environment.class);
        when(mockApplication.getEnvironment()).thenReturn(mockEnvironment);
        
        // Create mock Config that will be called for hasPath
        Config mockConfig = Mockito.mock(Config.class);
        when(mockApplication.getConfig()).thenReturn(mockConfig);
        
        // Configure mock Config to handle the hasPath call
        when(mockConfig.hasPath("websocket.maxSize")).thenReturn(false);
        when(mockConfig.hasPath("websocket.idleTimeout")).thenReturn(false);
        
        // Get the ServerOptions from Jetty instance
        ServerOptions options = new ServerOptions();
        
        // Configure SSL to be disabled to avoid SSL setup
        SslOptions sslOptions = new SslOptions();
        options.setSsl(sslOptions);
        
        // Set SSL to not enabled to avoid SSL connector creation
        // Note: ServerOptions doesn't have setSSLEnabled method, so we use the constructor
        // or set the ssl object to null to indicate SSL is not enabled
        options.setSsl(null);
        
        // Set port to a non-conflicting port
        options.setPort(0);
        
        // Set host
        options.setHost("localhost");
        
        // Disable HTTP2 to simplify setup
        options.setHttp2(false);
        
        // Set httpsOnly to false
        options.setHttpsOnly(false);
        
        // Set worker threads to minimal
        options.setWorkerThreads(1);
        
        // Set buffer size
        options.setBufferSize(8192);
        
        // Set max request size
        options.setMaxRequestSize(100000L);
        
        // Set default headers
        options.setDefaultHeaders(false);
        
        // Set compression level to null to avoid GzipHandler
        options.setCompressionLevel(null);
        
        // Use reflection to set the options field since there's no setter
        try {
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Start the server - this should trigger the Config.hasPath call
        jetty.start(mockApplication);
        
        // Clean up
        try {
            jetty.stop();
        } catch (Exception e) {
            // Ignore cleanup errors
        }
    }
}

