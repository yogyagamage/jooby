package io.jooby.jetty;

import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import org.junit.jupiter.api.Test;

import javax.net.ssl.SSLContext;
import java.security.NoSuchAlgorithmException;

public class Jettystart_HttpConfigurationsetMultiPartFormDataComplianceFikaTest {

    @Test
    public void testStart() throws Exception {
        Jetty jetty = new Jetty();
        
        ServerOptions options = new ServerOptions();
        options.setPort(0);
        options.setSecurePort(0);
        options.setBufferSize(8192);
        options.setMaxRequestSize(1000000L);
        options.setWorkerThreads(200);
        options.setDefaultHeaders(true);
        
        // Set SSL options to avoid httpsOnly exception
        SslOptions sslOptions = new SslOptions();
        sslOptions.setPort(0);
        
        // Create a mock SSL context to avoid NPE
        SSLContext sslContext;
        try {
            sslContext = SSLContext.getDefault();
        } catch (NoSuchAlgorithmException e) {
            sslContext = SSLContext.getInstance("TLS");
        }
        sslOptions.setSSLContext(sslContext);
        
        // Use reflection to set the options field since there's no setter
        try {
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Create a minimal Jooby application
        Jooby app = new Jooby();
        
        // Start the server - this should invoke HttpConfiguration.setMultiPartFormDataCompliance
        jetty.start(app);
        
        // Clean up to avoid resource leaks
        try {
            jetty.stop();
        } catch (Exception e) {
            // Ignore cleanup errors
        }
    }
}

