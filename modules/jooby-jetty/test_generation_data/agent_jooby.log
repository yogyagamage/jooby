}

private void ifStartAsync() {
    if (!request.isAsyncStarted()) {
        request.startAsync();
    }
}

void responseDone() {
    try {
        ifSaveSession();
        clearFiles();
    } finally {
        if (request.isAsyncStarted()) {
            request.getAsyncContext().complete();
        }
        if (listeners != null) {
            listeners.run(this);
        }
    }
}
