    @Test
    public void testStart() throws Exception {
        // Create Jetty instance using default constructor
        Jetty jetty = new Jetty();
        
        // Create a minimal Jooby application
        Jooby application = new Jooby();
        
        // Configure server options to avoid exceptions and reach the target method
        ServerOptions options = new ServerOptions();
        options.setPort(0); // Use port 0 to avoid bind conflicts
        options.setSecurePort(0); // Use port 0 to avoid bind conflicts
        options.setHttpsOnly(false); // Don't require SSL
        options.setSSLEnabled(false); // Disable SSL to simplify setup
        
        // Set the options on the Jetty instance
        jetty.setOptions(options);
        
        // Start the server - this should execute the full chain including
        // ContextHandler.addManaged() when WebSocketServerFactory is created
        jetty.start(application);
        
        // Clean up to avoid resource leaks
        Server server = jetty.getServer();
        if (server != null) {
            server.stop();
        }
    }
}

