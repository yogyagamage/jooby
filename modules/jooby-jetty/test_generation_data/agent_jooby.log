public class Jettystart_ServersetWantClientAuthFikaTest {

    @Test
    public void testStartInvokesSetWantClientAuth() throws Exception {
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Create ServerOptions with SSL enabled and client auth requested
        ServerOptions options = new ServerOptions();
        options.setSSLEnabled(true);
        options.setSecurePort(8443);
        options.setPort(8080);
        
        // Create SslOptions with client auth requested
        SslOptions sslOptions = new SslOptions();
        sslOptions.setClientAuth(SslOptions.ClientAuth.REQUESTED);
        
        // Set SSL options
        Method setSslMethod = ServerOptions.class.getDeclaredMethod("setSsl", SslOptions.class);
