import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import static java.util.stream.StreamSupport.stream;
import static java.util.Spliterators.spliteratorUnknownSize;
import java.util.ServiceLoader;
import java.util.Spliterator;

public class Jettystart_GzipHandlersetCompressionLevelFikaTest {

    @Test
    public void testStartWithCompressionLevel() throws Exception {
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Create a mock Jooby application
        Jooby application = Mockito.mock(Jooby.class);
        
        // Configure ServerOptions to enable compression
        ServerOptions options = new ServerOptions();
        options.setCompressionLevel(5); // This will trigger GzipHandler creation
        options.setPort(0); // Use port 0 to avoid binding conflicts
        options.setHttpsOnly(false); // Disable HTTPS to simplify setup
        options.setSSLEnabled(false); // Disable SSL to simplify setup
        
        // Set the options on the Jetty instance using reflection
        // since there's no setter provided in the fieldDeclarations
        java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
        optionsField.setAccessible(true);
        optionsField.set(jetty, options);
        
        // Start the server
        // This will execute the full chain and should invoke GzipHandler.setCompressionLevel(int)
        jetty.start(application);
        
        // Stop the server to clean up resources
        jetty.stop();
    }
}

