public class Jettystart_QueuedThreadPoolsetNameFikaTest {

    @Test
    public void testStart() throws Exception {
        Jetty jetty = new Jetty();
        
        // Create a minimal Jooby application
        Jooby app = new Jooby();
        
        // Configure ServerOptions to avoid exceptions and reach the target method
        ServerOptions options = new ServerOptions();
        options.setPort(0); // Use port 0 to avoid bind conflicts
        options.setWorkerThreads(1); // Minimal threads
        
        // Disable SSL to avoid SSL configuration issues
        options.setSecurePort(0);
        
        // Set options on Jetty instance using reflection
        Field optionsField = Jetty.class.getDeclaredField("options");
        optionsField.setAccessible(true);
        optionsField.set(jetty, options);
        
        // Start the server - this should invoke QueuedThreadPool.setName("worker")
        jetty.start(app);
        
        // No assertions needed - test passes if no exception is thrown
    }
}

