    @Test
    public void testStartInvokesWebSocketPolicySetIdleTimeout() throws Exception {
        // Create a minimal Jooby application with config that triggers websocket idle timeout
        Jooby application = new Jooby();
        
        // Create a Config with websocket.idleTimeout path
        Config config = ConfigFactory.parseString(
            "websocket.idleTimeout = 30000\n" +
            "websocket.maxSize = 1024"
        );
        
        // Use reflection to set the config since Jooby doesn't have a public setter
        try {
            java.lang.reflect.Field configField = Jooby.class.getDeclaredField("config");
            configField.setAccessible(true);
            configField.set(application, config);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Configure options to avoid SSL and enable normal HTTP
        ServerOptions options = new ServerOptions();
        options.setPort(0); // Use random port
        options.setSecurePort(0);
        options.setHttpsOnly(false);
        
        // Set SSL disabled
        SslOptions sslOptions = new SslOptions();
        sslOptions.setType(SslOptions.ClientAuth.NONE);
        options.setSsl(sslOptions);
        
        // Set options on Jetty instance
        try {
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Start the server - this should trigger the WebSocketPolicy.setIdleTimeout call
        jetty.start(application);
        
        // Clean up - stop the server
        try {
            java.lang.reflect.Field serverField = Jetty.class.getDeclaredField("server");
            serverField.setAccessible(true);
            Server server = (Server) serverField.get(jetty);
            if (server != null) {
                server.stop();
            }
        } catch (Exception e) {
            // Ignore cleanup errors
        }
    }
}

