import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import javax.net.ssl.SSLContext;
import java.util.concurrent.TimeUnit;

public class Jettystart_ServerConnectorsetHostFikaTest {

    @Test
    public void testStartCallsSetHost() throws Exception {
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Create a mock Jooby application
        Jooby mockApplication = Mockito.mock(Jooby.class);
        io.jooby.Environment mockEnvironment = Mockito.mock(io.jooby.Environment.class);
        com.typesafe.config.Config mockConfig = Mockito.mock(com.typesafe.config.Config.class);
        
        // Configure mock behavior
        Mockito.when(mockApplication.getEnvironment()).thenReturn(mockEnvironment);
        Mockito.when(mockEnvironment.getClassLoader()).thenReturn(ClassLoader.getSystemClassLoader());
        Mockito.when(mockApplication.getConfig()).thenReturn(mockConfig);
        Mockito.when(mockConfig.hasPath("websocket.maxSize")).thenReturn(false);
        Mockito.when(mockConfig.hasPath("websocket.idleTimeout")).thenReturn(false);
        
        // Configure SSL options to ensure SSL is disabled (so HTTP connector is created)
        ServerOptions options = jetty.getOptions();
        options.setPort(8080);
        options.setHost("localhost");
        options.setHttpsOnly(false);
        options.setSSLEnabled(false);
        
        // Start the server - this should create a ServerConnector and call setHost
        jetty.start(mockApplication);
        
        // Clean up to avoid resource leaks
        jetty.stop();
    }
}

