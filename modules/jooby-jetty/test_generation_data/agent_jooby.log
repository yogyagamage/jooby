            org.mockito.Mockito.when(spyOptions.getSSLContext(
                org.mockito.ArgumentMatchers.any(ClassLoader.class)))
                .thenReturn(mockContext);
            
            // Update the field with the spy
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, spyOptions);
            
        } catch (Exception e) {
            // If reflection fails, continue with original options
        }
        
        try {
            jetty.start(application);
        } catch (Exception e) {
            // Expected since we're not fully setting up the server
        }
    }
}

