import static org.mockito.Mockito.when;

public class Jettystart_DecoratedObjectFactorymethodFikaTest {

    @Test
    public void testStartCallsDecoratedObjectFactoryConstructor() throws Exception {
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Create mock Jooby application
        Jooby mockApplication = mock(Jooby.class);
        Environment mockEnvironment = mock(Environment.class);
        Config mockConfig = mock(Config.class);
        
        // Configure mock behavior
        when(mockApplication.getEnvironment()).thenReturn(mockEnvironment);
        when(mockEnvironment.getClassLoader()).thenReturn(ClassLoader.getSystemClassLoader());
        when(mockApplication.getConfig()).thenReturn(mockConfig);
        when(mockConfig.hasPath("websocket.maxSize")).thenReturn(false);
        when(mockConfig.hasPath("websocket.idleTimeout")).thenReturn(false);
        
        // Configure SSL to be disabled to avoid SSL context creation
        ServerOptions options = new ServerOptions();
        options.setSSLEnabled(false);
        options.setHttpsOnly(false);
        options.setHttp2(false);
        options.setPort(0); // Use port 0 to avoid bind conflicts
        options.setSecurePort(8443);
        options.setHost("localhost");
        options.setBufferSize(8192);
        options.setMaxRequestSize(1000000L);
        options.setWorkerThreads(10);
        options.setDefaultHeaders(false);
        
        // Use reflection to set the options field
        try {
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Start the server
        jetty.start(mockApplication);
        
        // Clean up to avoid resource leaks
        try {
            Server server = (Server) Jetty.class.getDeclaredField("server").get(jetty);
            if (server != null) {
                server.stop();
            }
        } catch (Exception e) {
            // Ignore cleanup exceptions
        }
    }
}

