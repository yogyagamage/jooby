package io.jooby.jetty;

import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import javax.net.ssl.SSLContext;
import java.util.concurrent.TimeUnit;

import static java.util.stream.StreamSupport.stream;
import static java.util.Spliterators.spliteratorUnknownSize;
import java.util.ServiceLoader;
import java.util.Spliterator;

public class Jettystart_ServerConnectormethodFikaTest {

    @Test
    public void testStartMethodInvokesServerConnectorConstructor() throws Exception {
        // Create instance of class under test
        Jetty jetty = new Jetty();
        
        // Create mock Jooby application
        Jooby mockJooby = Mockito.mock(Jooby.class);
        io.jooby.Environment mockEnvironment = Mockito.mock(io.jooby.Environment.class);
        com.typesafe.config.Config mockConfig = Mockito.mock(com.typesafe.config.Config.class);
        
        // Configure mock behavior
        Mockito.when(mockJooby.getEnvironment()).thenReturn(mockEnvironment);
        Mockito.when(mockEnvironment.getClassLoader()).thenReturn(ClassLoader.getSystemClassLoader());
        Mockito.when(mockJooby.getConfig()).thenReturn(mockConfig);
        Mockito.when(mockConfig.hasPath("websocket.maxSize")).thenReturn(false);
        Mockito.when(mockConfig.hasPath("websocket.idleTimeout")).thenReturn(false);
        
        // Configure SSL to be disabled to avoid SSL context creation
        // Access the options field directly since it's package-private
        ServerOptions options = new ServerOptions()
            .setServer("jetty")
            .setWorkerThreads(200)
            .setPort(8080)
            .setHost("localhost")
            .setBufferSize(8192)
            .setMaxRequestSize(1048576L)
            .setDefaultHeaders(true);
        
        // Set options to disable SSL and HTTPS only
        options.setSSLEnabled(false);
        options.setHttpsOnly(false);
        
        // Use reflection to set the options field since there's no setter
        try {
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Call the entry point method
        jetty.start(mockJooby);
    }
}

