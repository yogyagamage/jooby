package io.jooby.jetty;

import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import com.typesafe.config.Config;
import com.typesafe.config.ConfigFactory;
import org.eclipse.jetty.server.Server;
import org.junit.jupiter.api.Test;
import javax.net.ssl.SSLContext;
import java.security.NoSuchAlgorithmException;

public class Jettystart_ServerstartFikaTest {

    @Test
    public void testStart() throws Exception {
        Jetty jetty = new Jetty();
        
        ServerOptions options = new ServerOptions();
        options.setPort(0);
        options.setSecurePort(0);
        options.setHost("localhost");
        options.setWorkerThreads(1);
        options.setMaxRequestSize(1024L);
        options.setBufferSize(1024);
        options.setDefaultHeaders(false);
        
        SslOptions sslOptions = new SslOptions();
        sslOptions.setPort(0);
        sslOptions.setSecurePort(0);
        options.setSsl(sslOptions);
        
        try {
            SSLContext sslContext = SSLContext.getDefault();
            options.sslContext(sslContext);
        } catch (NoSuchAlgorithmException e) {
            // Use null SSL context if default is not available
        }
        
        // Use reflection to set the options field since there's no setter
        try {
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        Jooby application = new Jooby();
        
        // Set up minimal configuration to avoid NPE
        Config config = ConfigFactory.empty();
        application.setConfig(config);
        
        jetty.start(application);
    }
}

