package io.jooby.jetty;

import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import com.typesafe.config.Config;
import com.typesafe.config.ConfigFactory;
import org.eclipse.jetty.websocket.api.WebSocketPolicy;
import org.junit.jupiter.api.Test;

import javax.net.ssl.SSLContext;
import java.util.concurrent.TimeUnit;

public class Jettystart_WebSocketPolicysetMaxTextMessageSizeFikaTest {

    @Test
    public void testStartInvokesWebSocketPolicySetMaxTextMessageSize() throws Exception {
        Jetty jetty = new Jetty();
        
        Jooby application = new Jooby() {
            @Override
            public Config getConfig() {
                return ConfigFactory.parseString("websocket.maxSize = 65536\nwebsocket.idleTimeout = \"5 minutes\"");
            }
            
            @Override
            public io.jooby.Environment getEnvironment() {
                return new io.jooby.Environment(getClass().getClassLoader(), io.jooby.Environment.DEVELOPMENT) {
                    @Override
                    public ClassLoader getClassLoader() {
                        return Thread.currentThread().getContextClassLoader();
                    }
                };
            }
        };
        
        ServerOptions options = new ServerOptions();
        options.setPort(0);
        options.setSecurePort(0);
        options.setBufferSize(8192);
        options.setMaxRequestSize(1000000L);
        options.setWorkerThreads(200);
        options.setDefaultHeaders(true);
        
        SslOptions sslOptions = new SslOptions();
        sslOptions.setPort(0);
        sslOptions.setProtocol(java.util.Arrays.asList("TLSv1.2", "TLSv1.3"));
        
        SSLContext sslContext = SSLContext.getDefault();
        sslOptions.setSSLContext(sslContext);
        
        options.setSsl(sslOptions);
        
        java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
        optionsField.setAccessible(true);
        optionsField.set(jetty, options);
        
        jetty.start(application);
    }
}

