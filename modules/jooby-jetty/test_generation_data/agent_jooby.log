            output.flush();
        } catch (Throwable x) {
            if (Server.connectionLost(x) || (x instanceof EofException)) {
                close();
            } else {
                log.error("server-sent-event resulted in exception: id {} {}", id, jetty.getRequestPath(), x);
                if (SneakyThrows.isFatal(x)) {
