package io.jooby.jetty;

import com.typesafe.config.Config;
import io.jooby.Environment;
import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import javax.net.ssl.SSLContext;
import java.util.concurrent.TimeUnit;

public class Jettystart_ConfiggetDurationFikaTest {

    @Test
    public void testStart() throws Exception {
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Create mock Jooby
        Jooby mockJooby = Mockito.mock(Jooby.class);
        
        // Create mock Environment
        Environment mockEnv = Mockito.mock(Environment.class);
        
        // Create mock Config that will be called for getDuration
        Config mockConfig = Mockito.mock(Config.class);
        Mockito.when(mockConfig.hasPath("websocket.maxSize")).thenReturn(false);
        Mockito.when(mockConfig.hasPath("websocket.idleTimeout")).thenReturn(true);
        // This is the target third-party method call we want to invoke
        Mockito.when(mockConfig.getDuration("websocket.idleTimeout", TimeUnit.MILLISECONDS))
               .thenReturn(300000L); // Return 5 minutes in milliseconds
        
        // Setup mock Jooby to return our mock Config and Environment
        Mockito.when(mockJooby.getConfig()).thenReturn(mockConfig);
        Mockito.when(mockJooby.getEnvironment()).thenReturn(mockEnv);
        Mockito.when(mockEnv.getClassLoader()).thenReturn(Thread.currentThread().getContextClassLoader());
        
        // Configure ServerOptions
        ServerOptions options = jetty.options;
        // Set port to avoid address in use issues
        options.setPort(0);
        // Disable HTTPS to avoid SSL setup
        options.setSecurePort(0);
        // Set worker threads to a small number for test
        options.setWorkerThreads(1);
        // Set buffer size
        options.setBufferSize(8192);
        // Set max request size
        options.setMaxRequestSize(1000000L);
        // Disable HTTP2 to avoid ServiceLoader issues
        options.setHttp2(false);
        // Disable HTTPS only mode
        options.setHttpsOnly(false);
        
        // Create mock SSLContext to avoid NPE
        SSLContext mockSslContext = Mockito.mock(SSLContext.class);
        
        // Create SslOptions and configure it
        SslOptions sslOptions = new SslOptions();
        sslOptions.setProtocol(new String[]{"TLSv1.2"});
        sslOptions.setClientAuth(SslOptions.ClientAuth.NONE);
        
        // Set SSL options on ServerOptions
        options.setSsl(sslOptions);
        
        // Mock the SSLContext creation
        Mockito.when(mockEnv.getClassLoader()).thenReturn(Thread.currentThread().getContextClassLoader());
        
        // Start the server
        jetty.start(mockJooby);
        
        // Clean up
        if (jetty.server != null && jetty.server.isStarted()) {
            jetty.server.stop();
        }
    }
}

