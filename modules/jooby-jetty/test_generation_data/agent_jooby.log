    @Test
    public void testStartCallsSetStopAtShutdown() throws Exception {
        // Create instance using default constructor
        Jetty jetty = new Jetty();
        
        // Create a minimal Jooby application
        Jooby app = new Jooby();
        
        // Configure ServerOptions to avoid exceptions
        ServerOptions options = new ServerOptions();
        options.setPort(0); // Use random port
        options.setSecurePort(0); // Use random port
        options.setHttpsOnly(false);
        
        // Set SSL options to avoid SSL configuration issues
        SslOptions sslOptions = new SslOptions();
        sslOptions.setProtocol(new java.util.ArrayList<>());
        options.setSsl(sslOptions);
        
        // Set the options on the Jetty instance using reflection
        // since there's no setter provided
