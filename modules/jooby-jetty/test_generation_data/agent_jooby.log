package io.jooby.jetty;

import io.jooby.Jooby;
import io.jooby.ServerOptions;
import io.jooby.SslOptions;
import org.junit.jupiter.api.Test;

import javax.net.ssl.SSLContext;
import java.lang.reflect.Method;
import java.util.concurrent.TimeUnit;

public class Jettystart_ServersetHandlerFikaTest {

    @Test
    public void testStart_setHandler() throws Exception {
        // Create Jetty instance
        Jetty jetty = new Jetty();
        
        // Create a minimal Jooby application
        Jooby app = new Jooby();
        
        // Configure ServerOptions to avoid exceptions and reach the target method
        ServerOptions options = new ServerOptions();
        
        // Set required properties to avoid exceptions
        options.setPort(0); // Use port 0 to avoid bind conflicts
        options.setHost("localhost");
        options.setHttpsOnly(false);
        
        // Disable SSL to avoid SSLContext requirement
        options.setSSLEnabled(false);
        
        // Set buffer size to avoid NPE
        options.setBufferSize(8192);
        
        // Set max request size
        options.setMaxRequestSize(1024 * 1024L); // 1MB
        
        // Set worker threads
        options.setWorkerThreads(10);
        
        // Set default headers
        options.setDefaultHeaders(false);
        
        // Disable HTTP2 to simplify the path
        options.setHttp2(false);
        
        // Set compression level to null to avoid GzipHandler path
        // This will take the else branch: context.setHandler(handler)
        
        // Use reflection to set the options field since there's no setter
        try {
            Method setOptionsMethod = Jetty.class.getDeclaredMethod("setOptions", ServerOptions.class);
            setOptionsMethod.setAccessible(true);
            setOptionsMethod.invoke(jetty, options);
        } catch (NoSuchMethodException e) {
            // Fallback to field access if setter doesn't exist
            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        }
        
        // Start the server - this should invoke server.setHandler(context)
        jetty.start(app);
        
        // Clean up to avoid resource leaks
        try {
            if (jetty != null) {
                jetty.stop();
            }
        } catch (Exception e) {
            // Ignore cleanup exceptions
        }
    }
}

