    @Test
    void testCloseTriggersResponseDoneAndAsyncContextComplete() throws IOException {
        // Create mock objects for dependencies
        OutputStream mockOutputStream = Mockito.mock(OutputStream.class);
        Request mockRequest = Mockito.mock(Request.class);
        AsyncContext mockAsyncContext = Mockito.mock(AsyncContext.class);
        CompletionListeners mockListeners = Mockito.mock(CompletionListeners.class);
        
        // Configure mock request to return true for isAsyncStarted()
        Mockito.when(mockRequest.isAsyncStarted()).thenReturn(true);
        // Configure mock request to return mock AsyncContext
        Mockito.when(mockRequest.getAsyncContext()).thenReturn(mockAsyncContext);
        
        // Create JettyContext instance using reflection since we don't have the constructor
        // We'll use a mock that implements the necessary behavior
        JettyContext mockJettyContext = Mockito.mock(JettyContext.class);
        
        // Configure the mock to call the real responseDone method behavior
        // We need to ensure that when responseDone() is called, it triggers the async completion
        Mockito.doAnswer(invocation -> {
            // Simulate the responseDone() method behavior
            if (mockRequest.isAsyncStarted()) {
                mockRequest.getAsyncContext().complete();
            }
            if (mockListeners != null) {
                mockListeners.run(mockJettyContext);
            }
            return null;
        }).when(mockJettyContext).responseDone();
        
        // Create the JettyOutputStream instance using the constructor
        JettyOutputStream jettyOutputStream = new JettyOutputStream(mockOutputStream, mockJettyContext);
        
        // Call the entry point method
        jettyOutputStream.close();
        
        // No assertions or verifications required per constraints
    }
}

