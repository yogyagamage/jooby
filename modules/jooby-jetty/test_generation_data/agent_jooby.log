}

void responseDone() {
    try {
        ifSaveSession();
        clearFiles();
    } finally {
        if (request.isAsyncStarted()) {
            request.getAsyncContext().complete();
        }
        if (listeners != null) {
            listeners.run(this);
        }
    }
}
