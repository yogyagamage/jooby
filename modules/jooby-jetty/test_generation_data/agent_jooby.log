import org.junit.jupiter.api.Test;

import javax.net.ssl.SSLContext;
import java.security.NoSuchAlgorithmException;

public class Jettystart_HttpConnectionFactorymethodFikaTest {

    @Test
    public void testStartMethodCallsHttpConnectionFactoryConstructor() throws Exception {
        Jetty jetty = new Jetty();
        
        ServerOptions options = new ServerOptions();
        options.setPort(0);
        options.setSecurePort(0);
        options.setHttpsOnly(false);
        options.setSSLEnabled(false);
        
        SslOptions sslOptions = new SslOptions();
        sslOptions.setPort(0);
        try {
            sslOptions.setSSLContext(SSLContext.getDefault());
        } catch (NoSuchAlgorithmException e) {
            SSLContext sslContext = SSLContext.getInstance("TLS");
            sslContext.init(null, null, null);
            sslOptions.setSSLContext(sslContext);
        }
        options.setSsl(sslOptions);
        
        jetty.setOptions(options);
        
        Jooby jooby = new Jooby();
        
        jetty.start(jooby);
    }
}

