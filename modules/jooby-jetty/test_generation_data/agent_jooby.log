            java.lang.reflect.Field optionsField = Jetty.class.getDeclaredField("options");
            optionsField.setAccessible(true);
            optionsField.set(jetty, options);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
        
        // Start the server - this should invoke server.setStopAtShutdown(false)
        jetty.start(app);
        
        // Clean up to avoid resource leaks
        try {
            java.lang.reflect.Field serverField = Jetty.class.getDeclaredField("server");
            serverField.setAccessible(true);
            Server serverInstance = (Server) serverField.get(jetty);
            if (serverInstance != null) {
                serverInstance.stop();
            }
        } catch (Exception e) {
            // Ignore cleanup errors
        }
    }
}

