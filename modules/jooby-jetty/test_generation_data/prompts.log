        clearFiles();
    } finally {
        // PATH: Test should invoke the next Request.isAsyncStarted(...) [step in execution path]
        if (request.isAsyncStarted()) {
            request.getAsyncContext().complete();
        }
        if (listeners != null) {
            listeners.run(this);
        }
    }
}
