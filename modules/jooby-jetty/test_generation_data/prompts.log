@Nonnull
@Override
public Context upgrade(@Nonnull
ServerSentEmitter.Handler handler) {
    try // PATH: Test should invoke the next Response.flushBuffer(...) [step in execution path]
    {
        responseStarted = true;
        AsyncContext async = (request.isAsyncStarted()) ? request.getAsyncContext() : request.startAsync();
        /**
         * Infinite timeout because the continuation is never resumed but only completed on close.
         */
        async.setTimeout(0L);
        response.flushBuffer();
        handler.handle(new JettyServerSentEmitter(this));
        return this;
    } catch (Exception x) {
        throw SneakyThrows.propagate(x);
    }
}
