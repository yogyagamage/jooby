/**
 * Check if {@link ProblemDetailsHandler} is enabled as a global error handler
 *
 * @return boolean flag
 */
public boolean problemDetailsIsEnabled() {
    var config = getConfig();
    // PATH: Test should invoke the next Config.getBoolean(...) [step in execution path]
    return config.hasPath(ProblemDetailsHandler.ENABLED_KEY) && config.getBoolean(ProblemDetailsHandler.ENABLED_KEY);
}
