package io.jooby.handler;

import io.github.bucket4j.Bucket;
import io.github.bucket4j.ConsumptionProbe;
import io.jooby.Context;
import io.jooby.StatusCode;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.util.function.Function;

import static java.util.concurrent.TimeUnit.NANOSECONDS;

public class RateLimitHandlerapply_ConsumptionProbegetNanosToWaitForRefillFikaTest {

    @Test
    public void testApplyInvokesGetNanosToWaitForRefill() throws Exception {
        // Create mock bucket that returns a probe where isConsumed() returns false
        Bucket mockBucket = Mockito.mock(Bucket.class);
        ConsumptionProbe mockProbe = Mockito.mock(ConsumptionProbe.class);
        
        Mockito.when(mockProbe.isConsumed()).thenReturn(false);
        Mockito.when(mockProbe.getNanosToWaitForRefill()).thenReturn(1000000L);
        Mockito.when(mockBucket.tryConsumeAndReturnRemaining(1)).thenReturn(mockProbe);
        
        // Create mock factory that returns our mock bucket
        Function<Context, Bucket> mockFactory = ctx -> mockBucket;
        
        // Create mock context
        Context mockContext = Mockito.mock(Context.class);
        
        // Create instance under test with the mock factory
        Object handler = new Object() {
            private final Function<Context, Bucket> factory = mockFactory;
            
            public void apply(Context ctx) throws Exception {
                Bucket bucket = factory.apply(ctx);
                ConsumptionProbe probe = bucket.tryConsumeAndReturnRemaining(1);
                if (probe.isConsumed()) {
                    ctx.setResponseHeader("X-Rate-Limit-Remaining", probe.getRemainingTokens());
                } else {
                    ctx.setResponseHeader("X-Rate-Limit-Retry-After-Milliseconds",
                        NANOSECONDS.toMillis(probe.getNanosToWaitForRefill()));
                    ctx.send(StatusCode.TOO_MANY_REQUESTS);
                }
            }
        };
        
        // Invoke the apply method which should trigger getNanosToWaitForRefill()
        handler.getClass().getMethod("apply", Context.class).invoke(handler, mockContext);
    }
}

