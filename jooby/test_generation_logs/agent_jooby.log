        public static Environment loadEnvironment(EnvironmentOptions options) {
            Config sys = ConfigFactory.systemProperties()
                .withFallback(ConfigFactory.systemEnvironment());
            
            java.util.List<String> actives = options.getActiveNames();
            String filename = options.getFilename();
            String extension;
            int ext = filename.lastIndexOf('.');
            if (ext <= 0) {
                extension = ".conf";
            } else {
                extension = filename.substring(ext);
                filename = filename.substring(0, ext);
            }
            
