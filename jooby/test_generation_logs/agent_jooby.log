                    if (classpathConfig != null && !classpathConfig.isEmpty()) {
                        return classpathConfig;
                    }
                } catch (Exception e) {
                    // Continue to next location
                }
            }
            return ConfigFactory.empty();
        }
    }
    
    static class AvailableSettings {
        public static final String ENV = "env";
    }
