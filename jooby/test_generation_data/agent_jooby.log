/**
 * Creates a problem handler from configuration.
 *
 * <pre>{@code problem.details {
 *   enable: true
 *   muteCodes: [401, 106]
 *   muteTypes: ['com.example.MyException']
 * }}</pre>
 *
 * @param conf
