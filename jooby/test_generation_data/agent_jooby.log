            return this;
        }
        
        public void toProvider(Provider<V> provider) {
            provider.getClass();
        }
    }

    class MultiBinder<T> {
        private Collection<Provider<T>> services;
        
        private MultiBinder(Collection<Provider<T>> services) {
            this.services = services;
        }
    }
