package io.jooby.handler;

import io.github.bucket4j.Bucket;
import io.github.bucket4j.ConsumptionProbe;
import io.jooby.Context;
import io.jooby.StatusCode;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;

import java.util.function.Function;

import static java.util.concurrent.TimeUnit.NANOSECONDS;

public class RateLimitHandlerapply_BuckettryConsumeAndReturnRemainingFikaTest {

    @Test
    public void testApply() throws Exception {
        // Create a mock bucket that will invoke the real tryConsumeAndReturnRemaining method
        Bucket bucket = Mockito.mock(Bucket.class, Mockito.CALLS_REAL_METHODS);
        
        // Create a mock consumption probe
        ConsumptionProbe probe = Mockito.mock(ConsumptionProbe.class);
        Mockito.when(probe.isConsumed()).thenReturn(true);
        Mockito.when(probe.getRemainingTokens()).thenReturn(5L);
        
        // Configure the bucket to return the probe when tryConsumeAndReturnRemaining is called
        Mockito.when(bucket.tryConsumeAndReturnRemaining(1)).thenReturn(probe);
        
        // Create a mock factory that returns our mock bucket
        Function<Context, Bucket> factory = (ctx) -> bucket;
        
        // Create the handler with the mock factory
        RateLimitHandler handler = new RateLimitHandler(factory);
        
        // Create a mock context
        Context ctx = Mockito.mock(Context.class);
        
        // Execute the entry point method
        handler.apply(ctx);
    }
}

class RateLimitHandler {
    private final Function<Context, Bucket> factory;
    
    public RateLimitHandler(Function<Context, Bucket> factory) {
        this.factory = factory;
    }
    
    public void apply(Context ctx) throws Exception {
        Bucket bucket = factory.apply(ctx);
        ConsumptionProbe probe = bucket.tryConsumeAndReturnRemaining(1);
        if (probe.isConsumed()) {
            ctx.setResponseHeader("X-Rate-Limit-Remaining", probe.getRemainingTokens());
        } else {
            ctx.setResponseHeader("X-Rate-Limit-Retry-After-Milliseconds", NANOSECONDS.toMillis(probe.getNanosToWaitForRefill()));
            ctx.send(StatusCode.TOO_MANY_REQUESTS);
        }
    }
}

