interface ServiceRegistry {
    default <K, V> MapBinder<K, V> mapOf(@NonNull Class<K> keyType, @NonNull Reified<V> valueType) {
        return multiBinder(Reified.map(keyType, valueType.getType()), new MapBinder<>());
