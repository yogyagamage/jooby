package io.jooby.internal;

import io.jooby.ServiceKey;
import jakarta.inject.Provider;
import org.junit.jupiter.api.Test;

import java.util.HashMap;
import java.util.Map;

import static org.mockito.Mockito.mock;

class ServiceRegistryImplgetOrNull_ProvidergetFikaTest {

    @Test
    void testGetOrNullCallsProviderGet() {
        ServiceKey<String> key = ServiceKey.key(String.class);
        Provider<String> provider = () -> "test";
        
        Map<ServiceKey<?>, Provider<?>> registry = new HashMap<>();
        registry.put(key, provider);
        
        ServiceRegistryImpl serviceRegistry = new ServiceRegistryImpl(registry);
        serviceRegistry.getOrNull(key);
    }
    
    private static class ServiceRegistryImpl {
        private final Map<ServiceKey<?>, Provider<?>> registry;
        
        ServiceRegistryImpl(Map<ServiceKey<?>, Provider<?>> registry) {
            this.registry = registry;
        }
        
        public <T> T getOrNull(ServiceKey<T> key) {
            var provider = registry.get(key);
            if (provider == null) {
                return null;
            }
            return ((T) (provider.get()));
        }
    }
}

