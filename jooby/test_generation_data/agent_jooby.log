/**
 * Get cors options from application configuration file.
 *
 * <pre>{@code cors {
 * origin: *
 * methods: [GET, POST]
 * headers: [Custom-Header]
 * maxAge: 30m
 * exposesHeaders: [Header]
 * }}</pre>
 *
