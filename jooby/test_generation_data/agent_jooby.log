@Override
public void apply(@NonNull
Context ctx) throws Exception {
    Bucket bucket = factory.apply(ctx);
    // tryConsume returns false immediately if no tokens available with the bucket
    ConsumptionProbe probe = bucket.tryConsumeAndReturnRemaining(1);
    if (probe.isConsumed()) {
        ctx.setResponseHeader("X-Rate-Limit-Remaining", probe.getRemainingTokens());
    } else {
        ctx.setResponseHeader("X-Rate-Limit-Retry-After-Milliseconds", // PATH: Test should invoke the next ConsumptionProbe.getNanosToWaitForRefill(...) [step in execution path]
        NANOSECONDS.toMillis(probe.getNanosToWaitForRefill()));
        ctx.send(StatusCode.TOO_MANY_REQUESTS);
    }
}

